Q5)wap to insert a new element at the beginning of the array.
#include <stdio.h>
int main() {
    int n, i,m,position;
    printf("enter size of array:");
    scanf("%d",&n);
    int arr[n];
    for(i = 0; i < n; i++) {
        printf("Enter element %d of the array: ", i);
        scanf("%d", &arr[i]);
    }
    printf("the entered array is:\n");
    for(i = 0; i < n; i++) {
        printf("%d ", arr[i]);
    }
    printf("\n enter new element to be inserted:");
    scanf("%d",&m);
    printf("enter postion to be inserted:");
    scanf("%d",&position);
    for(i=n;i>=position;i--)
    {
        arr[i] = arr[i-1];
    }
    arr[position-1] = m;
    n++;
    printf("the new array is:\n");
    for(i = 0; i < n; i++) {
        printf("%d ", arr[i]);
    }
    return 0;
}

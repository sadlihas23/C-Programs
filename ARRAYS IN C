Q3)wap to count the number of even and odd number in an array

#include <stdio.h>
int main()
{
    int arr[10],i,eve=0,odd=0;
    for(i=0;i<10;i++){
        printf("enter the %d element of an array:",i);
        scanf("%d",&arr[i]);
    }
    for(i=0;i<10;i++){
        if(i%2==0){
            eve=eve+1;
        }
        else{
            odd=odd+1;
        }
    }
    printf("there are %d even numbers in array\n",eve);
    printf("there are %d odd numbers in array\n",odd);
    return 0;
}
